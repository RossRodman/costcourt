ANTHROPIC_API_KEY=

COSTCOURT_ENV=dev            # dev | test | prod
COSTCOURT_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
COSTCOURT_HOST=127.0.0.1
COSTCOURT_PORT=8000

COSTCOURT_DEBATER_MODEL=claude-sonnet-5-5
COSTCOURT_JUDGE_MODEL=claude-opus-5-5
COSTCOURT_MAX_OUTPUT_TOKENS=4096
COSTCOURT_REQUEST_TIMEOUT_S=120

COSTCOURT_DEBATE_ROUNDS=2    # 1..5
