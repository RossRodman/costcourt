ANTHROPIC_API_KEY=

COSTCOURT_ENV=dev            # dev | test | prod
COSTCOURT_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
COSTCOURT_HOST=127.0.0.1
COSTCOURT_PORT=8000

COSTCOURT_DEBATER_MODEL=claude-opus-5-5
COSTCOURT_JUDGE_MODEL=claude-opus-5-5
COSTCOURT_DEBATER_EFFORT=medium     # low | medium | high | xhigh | max
COSTCOURT_JUDGE_EFFORT=high
COSTCOURT_MAX_OUTPUT_TOKENS=16000
COSTCOURT_REQUEST_TIMEOUT_S=300

COSTCOURT_DEBATE_ROUNDS=2    # 1..5
COSTCOURT_DEMO_DELAY_S=2.5   # simulated thinking time in demo
